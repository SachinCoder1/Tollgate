# keepertoll — environment variables
#
# Copy to .env at the project root for local dev. Never commit .env.
# All values below are placeholders — replace with real ones before running.

# ─── KeeperHub ─────────────────────────────────────────────────────────────────
# Org-scoped API key from app.keeperhub.com → Settings → API Keys.
# Used by the gateway to call POST /api/workflow/{id}/execute on behalf of the author.
KEEPERHUB_API_KEY=kh_replace_me

# Base URL for the KeeperHub REST API. Override only for staging/local mocks.
KEEPERHUB_API_BASE=https://app.keeperhub.com/api

# ─── Gateway (Architecture B) ──────────────────────────────────────────────────
# Port the gateway listens on locally.
GATEWAY_PORT=3030

# Public origin the gateway is reachable at. Used for x402 payment-requirement URLs.
GATEWAY_PUBLIC_URL=http://localhost:3030

# Where the gateway persists its workflow registry (JSON file for now).
GATEWAY_REGISTRY_PATH=./.keepertoll/registry.json

# Where the gateway appends a JSONL audit log (one row per successful paid call).
# Used to populate SUBMISSION.md "External Adoption" via GET /admin/audit.
GATEWAY_AUDIT_LOG_PATH=./.keepertoll/audit.log

# Shared bearer token the CLI sends to the gateway's /admin/* routes. The
# gateway refuses to start without it. Generate any random ~32-byte string.
GATEWAY_ADMIN_TOKEN=replace_me_with_a_long_random_string

# ─── x402 / payment ────────────────────────────────────────────────────────────
# CAIP-2 chain ID for x402 payments. eip155:84532 = Base Sepolia (testnet default).
X402_NETWORK=eip155:84532

# x402 facilitator URL. Coinbase's hosted testnet facilitator requires no auth.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Address that receives payments for workflow calls. Must control USDC on the
# X402_NETWORK chain. For mainnet, use the author's own EOA / smart wallet.
X402_PAY_TO=0x0000000000000000000000000000000000000000

# ─── Reference agent / SDK callers ─────────────────────────────────────────────
# Private key of the EOA used by the reference agent to sign x402 payment
# authorizations. Testnet only. Never put a mainnet key here.
AGENT_PRIVATE_KEY=0xreplace_me_with_a_test_only_key

# Hard cap (USD) the agent will spend across all SDK calls per process run.
# Acts as a budget guardrail; SDK throws BudgetExceededError above this.
AGENT_BUDGET_USD=1.00

# ─── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
