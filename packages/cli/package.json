{
  "name": "@keepertoll/cli",
  "version": "0.0.0",
  "private": true,
  "description": "keeperhub-publish — CLI for KeeperHub workflow authors to publish workflows as x402-paid endpoints.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keeperhub-publish": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
