{
  "name": "@keepertoll/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "x402 gateway for keepertoll. Validates payments and proxies calls to KeeperHub's execute_workflow.",
  "keywords": ["keeperhub", "x402", "gateway", "hono", "agent", "workflow"],
  "license": "MIT",
  "author": "Sachin Gurjar and the keepertoll authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachingurjar/keepertoll.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/sachingurjar/keepertoll/tree/main/packages/gateway#readme",
  "bugs": {
    "url": "https://github.com/sachingurjar/keepertoll/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.16",
    "viem": "^2.21.0",
    "x402": "^1.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.0"
  }
}
